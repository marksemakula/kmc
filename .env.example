# Copy this file to .env and fill in real values. .env is gitignored.

# Existing DeepSeek chat widget key
VITE_DEEPSEEK_API_KEY=

# SMTP credentials used by the /api/apply serverless function to email
# Careers job applications (with the merged CV/certificates PDF) to
# admin@kayewell.or.ug. These are server-only — do NOT prefix with VITE_,
# or they would be exposed in the client-side bundle.
#
# Use credentials for whichever mailbox should send these emails: an App
# Password for admin@kayewell.or.ug (if it's Gmail/Google Workspace), or the
# SMTP host/user/password from wherever that mailbox is hosted.
#
# Also set these in your Vercel project's Environment Variables for
# production (Project Settings -> Environment Variables).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER if not set
SMTP_FROM=
